{
  "name": "isaac-console-assistant",
  "version": "1.1.0",
  "private": true,
  "description": "以撒控制台助手 · Repentance 1.7.9b 离线命令速查",
  "author": "Local Tools",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "catalog": "python scripts/build_catalog.py",
    "test": "tsx --test tests/core.test.ts && node --test tests/state.test.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "package": "npm run build && electron-builder --win dir && node scripts/package.cjs"
  },
  "dependencies": { "pinyin-pro": "^3.27.0" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "local.isaac.console.assistant",
    "productName": "以撒控制台助手",
    "directories": { "output": "release" },
    "electronDist": "node_modules/electron/dist",
    "files": ["dist/**/*", "electron/**/*", "package.json", "THIRD-PARTY-NOTICES.md"],
    "asar": true,
    "win": { "target": "dir", "signAndEditExecutable": false, "executableName": "IsaacConsoleAssistant" }
  }
}
